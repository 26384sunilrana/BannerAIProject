      "name": "Subscription Plans",
      "item": [
        {
          "name": "Get All Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/subscriptions/plans",
              "host": ["{{base_url}}"],
              "path": ["api", "subscriptions", "plans"]
            }
          }
        },
        {
          "name": "Get Plan by ID",
          "request": {
            "method": "GET",
            "header": [],
