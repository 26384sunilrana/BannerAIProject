            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopId\": \"{{shop_id}}\",\n  \"planId\": \"{{plan_id}}\",\n  \"billingPeriod\": 0,\n  \"paymentMethodId\": \"pm_123456\",\n  \"trialDays\": 14\n}"
